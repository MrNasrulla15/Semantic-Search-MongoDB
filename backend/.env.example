# ── Server ────────────────────────────────────────────────────────────────────
PORT=5000

# ── MongoDB Atlas ─────────────────────────────────────────────────────────────
# Full SRV connection string from MongoDB Atlas → Connect → Drivers
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority

# Name of the Atlas Vector Search index (must match the index created in Atlas UI)
VECTOR_INDEX_NAME=vector_index

# ── Google Gemini ─────────────────────────────────────────────────────────────
# Generate at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Embedding model — text-embedding-004 produces 768-dimensional vectors
GEMINI_EMBEDDING_MODEL=text-embedding-004

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins
# Example for local dev: http://localhost:5173
# Example for production: https://yourdomain.com
CORS_ORIGIN=http://localhost:5173

# ── Environment ───────────────────────────────────────────────────────────────
# Set to "production" in deployed environments to suppress internal error details
NODE_ENV=development
